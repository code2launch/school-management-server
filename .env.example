# ── Database ──────────────────────────────────────────────────
DATABASE_URL="postgresql://postgres:password@localhost:5432/school_management_db"

# ── Server ────────────────────────────────────────────────────
NODE_ENV="development"
PORT=5000
FRONTEND_URL="http://localhost:3000"

# ── JWT ───────────────────────────────────────────────────────
JWT_ACCESS_SECRET="your-super-secret-access-key-change-in-production"
JWT_REFRESH_SECRET="your-super-secret-refresh-key-change-in-production"
JWT_ACCESS_EXPIRES_IN="1d"
JWT_REFRESH_EXPIRES_IN="30d"

# ── Admin Seed ────────────────────────────────────────────────
ADMIN_NAME="School Admin"
ADMIN_PHONE="01700000000"
ADMIN_PASSWORD="Admin@1234"

# ── School Info (used in seed) ────────────────────────────────
SCHOOL_NAME="Greenfield School"
SCHOOL_ADDRESS="Dhaka, Bangladesh"
SCHOOL_PHONE="01700000001"
SCHOOL_EMAIL="info@greenfieldschool.edu.bd"
