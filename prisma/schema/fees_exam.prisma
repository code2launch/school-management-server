model FeeStructure {
  id      String  @id @default(uuid())
  classId String?
  feeType FeeType

  amount Decimal @db.Decimal(10, 2)

  label          String
  academicYearId String

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  academicYear AcademicYear @relation(fields: [academicYearId], references: [id])

  @@index([academicYearId])
  @@index([classId])
  @@index([feeType])
  @@map("fee_structures")
}

model FeePayment {
  id String @id @default(uuid())

  receiptNumber String @unique

  studentId      String
  academicYearId String

  feeType FeeType

  month Int?
  year  Int?

  amount     Decimal @db.Decimal(10, 2)
  paidAmount Decimal @db.Decimal(10, 2)
  dueAmount  Decimal @db.Decimal(10, 2)

  paymentStatus PaymentStatus @default(UNPAID)

  paymentMethod String?
  paymentDate   DateTime?

  collectedBy String?
  note        String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  student Student @relation(fields: [studentId], references: [id])

  academicYear AcademicYear @relation(fields: [academicYearId], references: [id])

  @@index([studentId])
  @@index([academicYearId])
  @@index([paymentStatus])
  @@index([feeType])
  @@index([month, year])
  @@map("fee_payments")
}

// ─── EXAMS ───────────────────────────────────────────────────

enum ExamType {
  CLASS_TEST
  MID_TERM
  FINAL
  OTHER
}

model Exam {
  id             String    @id @default(uuid())
  name           String
  examType       ExamType
  classId        String? // null = all classes
  academicYearId String
  startDate      DateTime?
  endDate        DateTime?
  isPublished    Boolean   @default(false)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  academicYear AcademicYear  @relation(fields: [academicYearId], references: [id])
  subjects     ExamSubject[]
  results      ExamResult[]

  @@map("exams")
}

model ExamSubject {
  id         String    @id @default(uuid())
  examId     String
  subjectId  String
  totalMarks Float     @default(100)
  passMarks  Float     @default(33)
  examDate   DateTime?
  createdAt  DateTime  @default(now())

  exam    Exam    @relation(fields: [examId], references: [id])
  subject Subject @relation(fields: [subjectId], references: [id])

  @@unique([examId, subjectId])
  @@map("exam_subjects")
}

model ExamResult {
  id            String   @id @default(uuid())
  examId        String
  studentId     String
  sectionId     String
  subjectId     String
  marksObtained Float
  totalMarks    Float
  grade         String? // A+, A, B, etc.
  gradePoint    Float? // GPA
  isPassed      Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  exam    Exam    @relation(fields: [examId], references: [id])
  student Student @relation(fields: [studentId], references: [id])
  section Section @relation(fields: [sectionId], references: [id])
  subject Subject @relation(fields: [subjectId], references: [id])

  @@unique([examId, studentId, subjectId])
  @@map("exam_results")
}

// ─── NOTICE ──────────────────────────────────────────────────

enum NoticeAudience {
  ALL
  STUDENTS
  PARENTS
  TEACHERS
  STAFF
}

model Notice {
  id          String         @id @default(uuid())
  title       String
  content     String
  audience    NoticeAudience @default(ALL)
  publishedBy String // userId
  isPublished Boolean        @default(true)
  isDeleted   Boolean        @default(false)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@map("notices")
}
